# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 항목은 기능이 붙을 때마다 여기에 추가한다 (값은 비워 둔다).

# 서버 포트 (기본 8080)
SERVER_PORT=

# DB (로컬은 비워 두면 compose.yaml 기본값 mspace/mspace 사용)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 임시: 로그인 전까지 X-User-Id 헤더 허용 (로컬에서만 true)
MSPACE_DEV_HEADER=false

# 장치별 토큰 (키패드·QR·센서·방 카메라의 Authorization: Bearer). "deviceId:roomId:토큰"을 쉼표로 잇는다.
# 예: MSPACE_DEVICES=keypad-1:1:<토큰>,qr-1:1:<토큰>. 토큰이 그 방에 묶인다. 채팅·저장소에 올리지 않는다
MSPACE_DEVICES=
# 예전 공용 장치 토큰(모든 방). 장치를 MSPACE_DEVICES로 다 옮기면 비운다
MSPACE_DEVICE_TOKEN=

# 로그인 토큰 서명값 (32바이트 이상, 예: openssl rand -base64 48). 비우면 로컬 전용 임시값
JWT_SECRET=
# 액세스 토큰 유효 시간 (기본 1h), 자동 로그인(refresh 토큰) 기간 (기본 14d)
# JWT_TTL=1h
# JWT_REFRESH_TTL=14d
# refresh 토큰은 HttpOnly 쿠키로만 준다. 운영(HTTPS)은 true 그대로.
# Chrome·Firefox는 http://localhost에서도 Secure 쿠키를 받는다. Safari로 http 시험할 때만 false
# MSPACE_AUTH_COOKIE_SECURE=true

# 인증번호 메일. false(기본)면 메일 대신 서버 로그에 번호를 찍는다
MAIL_ENABLED=false
# 팀 Gmail 주소와 앱 비밀번호 (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=
# 기본 smtp.gmail.com / 587
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# 경고 철회 요청 Gemini 판단기 (FR-RPT-105). 비우면 규칙 판단기만 써요. AI Studio 무료 키, 결제 연결 안 함
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
